# Copy to `.env.local` for local dev, and set the same vars in your host
# (e.g. Vercel → Project → Settings → Environment Variables) for production.
# `.env*` files are gitignored — never commit real secrets.

# ── SEO ─────────────────────────────────────────────────────────────────────
# Your real public domain. Drives Open Graph/Twitter share tags, the sitemap,
# and robots.txt. Without it those URLs fall back to a placeholder.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Keystatic CMS storage ───────────────────────────────────────────────────
# Leave the repo UNSET to use local mode (edits write to local files you commit).
# Set it to "owner/repo" to switch the /keystatic admin to GitHub mode, where
# edits commit straight to GitHub from the hosted admin.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=

# These four are generated for you by Keystatic's GitHub App setup wizard:
# after setting the repo above, run the app and open /keystatic — it walks you
# through creating the GitHub App and writes these into your .env automatically.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
